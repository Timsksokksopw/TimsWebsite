---
import { site, navFlat } from '../data/site';
const year = new Date().getFullYear();
const c = site.contact;
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__cta">
        <p class="eyebrow">Lust auf ein Hallo?</p>
        <a href="/kontakt/" class="footer__big" data-cursor="link">
          Schreib mir<span class="footer__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer__cols">
        <div>
          <p class="footer__label">Seiten</p>
          <ul>
            <li><a class="link" href="/">Start</a></li>
            {navFlat.map((n) => <li><a class="link" href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer__label">Projekte</p>
          <ul>
            <li><a class="link" href={site.links.wendico} target="_blank" rel="noopener">wendico.ch ↗</a></li>
            <li><a class="link" href={site.links.lostrios} target="_blank" rel="noopener">lostrios.ch ↗</a></li>
          </ul>
        </div>
        <div>
          <p class="footer__label">Kontakt</p>
          <ul>
            <li><a class="link" href={c.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
            {c.instagram && (
              <li><a class="link" href={`https://www.instagram.com/${c.instagram}/`} target="_blank" rel="noopener">Instagram ↗</a></li>
            )}
            <li><a class="link" href={c.phoneHref}>{c.phoneDisplay}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {year} Tim Biedermann</span>
      <span>Gestaltung und Umsetzung: <a class="link" href={site.links.wendico} target="_blank" rel="noopener">Wendico</a></span>
      <a href="#top" class="link" data-to-top>Nach oben ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: 1.6rem;
    position: relative;
    overflow: hidden;
  }
  .footer__top {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: 1.15fr 1fr;
    align-items: end;
  }
  .footer__big {
    display: inline-flex;
    align-items: baseline;
    gap: 0.15em;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(2.8rem, 6.8vw, 6.4rem);
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.4s;
  }
  .footer__big:hover {
    color: var(--accent);
  }
  .footer__arrow {
    display: inline-block;
    font-size: 0.6em;
    transition: transform 0.6s var(--ease-spring);
  }
  .footer__big:hover .footer__arrow {
    transform: translate(0.12em, -0.12em) rotate(8deg);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .footer__label {
    font-size: 0.86rem;
    color: var(--muted);
    margin-bottom: 0.9rem;
    font-weight: 600;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.98rem;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
