---
// Loader bei jedem Seitenaufruf: Das Logo-T wird gezeichnet und füllt sich mit Gold,
// während Foto, Schriften und 3D-Szenen der Seite laden. Beim ersten Besuch einer Sitzung bleibt er
// etwas länger stehen, bei jedem weiteren Seitenwechsel läuft die kürzere Fassung. Die Steuerung steht unten als Inline-Skript.
// Styles stehen inline, damit der Loader vor allem anderen erscheint.
// Sichtbar ist er nur, wenn das kleine Skript im <head> (Base.astro) die Klasse «loading» gesetzt hat.
import { T_PARTS, T_VIEWBOX, T_SIZE } from '../data/logo';
const parts = [T_PARTS.left, T_PARTS.right, T_PARTS.stem];
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__inner">
    <svg class="loader__t" viewBox={`-4 -4 ${T_SIZE.w + 8} ${T_SIZE.h + 8}`} data-viewbox={T_VIEWBOX}>
      <defs>
        <linearGradient id="loader-gold" x1="0.1" y1="0" x2="0.9" y2="1">
          <stop offset="0" stop-color="#e2b04a"></stop>
          <stop offset="0.5" stop-color="#c08a26"></stop>
          <stop offset="1" stop-color="#8a5d12"></stop>
        </linearGradient>
        <clipPath id="loader-rise">
          <rect data-loader-rise x="-4" y={T_SIZE.h + 4} width={T_SIZE.w + 8} height={T_SIZE.h + 8}></rect>
        </clipPath>
      </defs>
      <g clip-path="url(#loader-rise)" fill="url(#loader-gold)">
        {parts.map((d) => <path d={d} />)}
      </g>
      <g class="loader__lines" data-loader-lines fill="none" stroke="#0d1322" stroke-width="0.9" stroke-linejoin="round">
        {parts.map((d) => <path d={d} pathLength="1" />)}
      </g>
    </svg>
    <p class="loader__name">Tim Biedermann</p>
    <p class="loader__pct"><span data-loader-pct>0</span>&thinsp;%</p>
  </div>
</div>

<script is:inline>
  // Steuerung des Loaders. Steht direkt in der Seite, damit die Uhr ab dem ersten Bild läuft
  // und nicht erst, wenn die Skript-Dateien geladen sind. src/scripts/loader.ts reicht sie an die Seiten weiter.
  (function () {
    var root = document.documentElement;
    var el = document.querySelector('[data-loader]');
    if (!el || !root.classList.contains('loading')) return;
    var short = root.classList.contains('loader-short'); // nicht der erste Seitenaufruf dieser Sitzung
    var MIN_MS = short ? 600 : 1300; // so lange bleibt der Loader mindestens stehen, damit man das Zeichnen sieht
    var MAX_MS = 7000; // spätestens dann geht es weiter, auch wenn etwas hängt
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var lines = Array.prototype.slice.call(el.querySelectorAll('[data-loader-lines] path'));
    var linesGroup = el.querySelector('[data-loader-lines]');
    var rise = el.querySelector('[data-loader-rise]');
    var pct = el.querySelector('[data-loader-pct]');
    var top = Number(rise.getAttribute('y'));
    var height = Number(rise.getAttribute('height'));
    var tasks = {};
    var waiting = [];
    var finished = false;
    var shown = 0;
    var start = performance.now();
    var last = start;

    var api = (window.__tb = {
      active: true,
      // Aufgabe anmelden; sie zählt als erledigt, sobald das Promise fertig ist (auch bei Fehler)
      track: function (name, promise) {
        if (finished) return;
        tasks[name] = false;
        var done = function () {
          tasks[name] = true;
        };
        Promise.resolve(promise).then(done, done);
      },
      // ruft fn auf, sobald der Loader weg ist
      whenDone: function (fn) {
        if (finished) fn();
        else waiting.push(fn);
      },
      get finished() {
        return finished;
      },
      get progress() {
        return finished ? 1 : shown;
      },
      get tasks() {
        return tasks;
      },
    });

    api.track('schriften', document.fonts && document.fonts.ready);
    api.track(
      'seite',
      new Promise(function (res) {
        if (document.readyState === 'complete') res();
        else window.addEventListener('load', res, { once: true });
      }),
    );

    function draw(p) {
      var stroke = reduced ? 1 : Math.min(1, p / 0.55);
      var fill = reduced ? p : Math.min(1, Math.max(0, (p - 0.2) / 0.8));
      lines.forEach(function (l, i) {
        l.style.strokeDashoffset = String(1 - Math.min(1, Math.max(0, stroke * 1.25 - i * 0.12)));
      });
      linesGroup.style.opacity = String(1 - fill);
      // die Goldfüllung steigt von unten nach oben
      rise.setAttribute('y', String(top - (height - 4) * fill));
      pct.textContent = String(Math.round(p * 100));
    }

    function finish() {
      if (finished) return;
      finished = true;
      try {
        sessionStorage.setItem('tb-loaded', '1');
      } catch (e) {}
      root.classList.add('loader-out');
      waiting.splice(0).forEach(function (fn) {
        fn();
      });
      setTimeout(function () {
        root.classList.remove('loading', 'loader-out', 'loader-short');
      }, reduced ? 320 : short ? 650 : 900);
    }

    function frame(now) {
      if (finished) return;
      var dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      var elapsed = now - start;
      var names = Object.keys(tasks);
      var done = names.filter(function (n) {
        return tasks[n];
      }).length;
      var allDone = (done === names.length && elapsed >= MIN_MS) || elapsed >= MAX_MS;
      // zwischen zwei erledigten Aufgaben kriecht die Anzeige langsam weiter, bleibt aber unter der nächsten Stufe
      var target = allDone ? 1 : Math.min(0.94, (done + 0.7 * (1 - Math.exp(-elapsed / 2500))) / Math.max(1, names.length));
      shown = Math.max(shown, shown + (target - shown) * (1 - Math.exp(-dt * (allDone ? 7 : 3.5))));
      if (allDone && shown > 0.992) {
        shown = 1;
        draw(1);
        setTimeout(finish, reduced ? 0 : 260);
        return;
      }
      draw(shown);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    // lädt der Tab im Hintergrund, läuft requestAnimationFrame nicht: dann nach der Höchstzeit direkt freigeben
    setTimeout(finish, MAX_MS + 1500);
  })();
</script>

<style is:inline>
  .loader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 400;
    background: #f3f0e9;
    color: #0d1322;
    place-items: center;
    clip-path: inset(0 0 0 0);
  }
  html.loading .loader {
    display: grid;
  }
  html.loading {
    overflow: hidden;
  }
  .loader__inner {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    transition: transform 0.85s cubic-bezier(0.7, 0, 0.2, 1), opacity 0.5s;
  }
  .loader__t {
    height: min(34vh, 15rem);
    width: auto;
    margin-bottom: 1.2rem;
    overflow: visible;
  }
  .loader__lines path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .loader__name {
    margin: 0;
    font: 600 1.15rem/1.2 'Schibsted Grotesk Variable', 'Segoe UI', system-ui, sans-serif;
    letter-spacing: -0.01em;
  }
  .loader__pct {
    margin: 0;
    font: 500 0.95rem/1.2 'Schibsted Grotesk Variable', 'Segoe UI', system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    color: #8a5d12;
  }
  /* fertig: der Vorhang hebt sich nach oben */
  html.loader-out .loader {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s cubic-bezier(0.7, 0, 0.2, 1);
  }
  html.loader-out .loader__inner {
    transform: translateY(-12vh);
    opacity: 0;
  }
  /* kürzere Fassung beim Seitenwechsel */
  html.loader-short.loader-out .loader {
    transition-duration: 0.6s;
  }
  html.loader-short.loader-out .loader__inner {
    transition-duration: 0.6s, 0.35s;
  }
  @media (prefers-reduced-motion: reduce) {
    html.loader-out .loader {
      clip-path: none;
      opacity: 0;
      transition: opacity 0.3s;
    }
    html.loader-out .loader__inner {
      transform: none;
    }
  }
</style>
