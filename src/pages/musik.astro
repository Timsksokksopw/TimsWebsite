---
// Musik-Seite in der Welt von Los Trios: nur Schwarz und Weiss wie das Bandlogo, Titel in Bodoni kursiv.
// Fotos sind schwarz-weiss und zeigen ihre Farbe erst beim Überfahren. Farbig ist sonst nur die Gitarre.
import { Image } from 'astro:assets';
import '@fontsource-variable/libre-bodoni/wght-italic.css'; // Titelschrift der Seite und Signatur auf der Kopfplatte der Gitarre
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { fotos, foto } from '../data/fotos';
import { site } from '../data/site';
import logoUrl from '../assets/logos/lostrios.svg?url';

const kid = foto('tim-als-kind');
const studio = foto('studio-session');
const head = foto('ibanez-kopfplatte');
const waldhof = foto('waldhof-live');
const live = foto('live-drei-gitarren');
const gallery = fotos('musik', 'band');

const chords = ['Em', 'G', 'D', 'C', 'Am', 'A', 'E', 'E5'];
const pedals = [
  { id: 'drive', label: 'Drive', color: '#f2f2f2', hint: 'Verzerrer' },
  { id: 'chorus', label: 'Chorus', color: '#c9c9c9', hint: 'Chorus: macht den Klang breit und schwebend' },
  { id: 'delay', label: 'Delay', color: '#e2e2e2', hint: 'Delay: Echo im Takt' },
  { id: 'wah', label: 'Wah', color: '#b8b8b8', hint: 'Wah: Maus hoch und runter bewegt das Pedal' },
  { id: 'reverb', label: 'Hall', color: '#d6d6d6', hint: 'Hall: grosser Raum' },
];
const how = [
  ['Saiten & Griffbrett', 'Fahr mit der Maus über die Saiten oder klick aufs Griffbrett. Jeder Bund klingt so, wie er soll.'],
  ['Akkorde', 'Wähl einen Akkord, die leuchtenden Punkte zeigen dir den Griff. Mit der Leertaste schlägst du ihn an.'],
  ['Pedale & Tremolo', 'Verzerrer, Chorus, Delay, Wah und Hall lassen sich einzeln treten. Den Tremolohebel ziehst du direkt an der Gitarre.'],
  ['Band & Looper', 'Lass Schlagzeug und Bass mitlaufen oder nimm eine Runde auf und spiel ein Solo darüber.'],
];
const lineup = [
  ['Jarina', 'Gesang'],
  ['Kevin', 'Lead-Gitarre'],
  ['Tim', 'Lead-Gitarre & Solos'],
  ['Moos', 'Bass'],
  ['Lenny', 'Schlagzeug'],
];
const chronik = [
  ['Jan 2023', 'Gründung', 'Drei Freunde starten eine Band. Alle drei spielen Gitarre, daher der Name.'],
  ['6. Juli 2024', 'Waldhoffest', 'Auftritt am Waldhoffest in Andelfingen.'],
  ['4. Jan 2025', 'Januar-Show', 'Volle Bühne, Hemd und Krawatte.'],
  ['16. Aug 2025', 'Erste Studio-Session', 'Aufnahmen mit Access Audio Productions.'],
  ['22. Okt 2025', '«Overdose of Everything»', 'Die ersten Songs erscheinen auf Spotify.'],
  ['24. Mai 2026', 'Thur Pfingsten', 'Live auf dem Püntenhof in Andelfingen.'],
  ['6. Juni 2026', 'Waldhoffest, die Zweite', 'Zurück auf der Bühne, auf der es angefangen hat.'],
  ['Okt 2026', 'Zweite Studio-Session', 'Drei neue Songs im Kasten.'],
];
const neuesFenster = ' (öffnet neues Fenster)';
---

<Base
  page="musik"
  theme="stage"
  world="lostrios"
  title="Musik"
  description="Tim Biedermann spielt Lead-Gitarre bei der Hard-Rock-Band Los Trios. Hier kannst du seine Gitarre direkt im Browser spielen."
>
  <section class="mhero" data-music-host data-cursor="grab">
    <div class="stage3d" data-music-stage></div>
    <div class="mhero__top container">
      <div class="mhero__text" data-music-text>
        <p class="mhero__where">Lead-Gitarre bei Los Trios</p>
        <h1>Dreh auf.</h1>
        <p class="mhero__lead">
          Meine Gitarre, nachgebaut in 3D. Schalt den Amp ein und spiel drauflos: Saiten, Griffbrett, Tremolohebel und Regler funktionieren
          wie am Original.
        </p>
      </div>
    </div>
    <div class="mtip" data-music-tip aria-hidden="true"></div>

    <div class="board container" data-music-ui data-cursor="none">
      <div class="board__panel">
        <div class="board__row">
          <button class="amp" data-amp aria-pressed="false">
            <span class="amp__led" aria-hidden="true"></span>
            <span class="amp__txt"><b>Amp</b><i class="amp__off">einschalten</i><i class="amp__on">läuft</i></span>
          </button>
          <div class="lcd">
            <canvas class="lcd__scope" data-scope width="320" height="96" aria-hidden="true"></canvas>
            <div class="lcd__main">
              <span class="lcd__label" data-lcd-label>Akkord</span>
              <strong class="lcd__chord" data-lcd-chord aria-live="polite">offen</strong>
            </div>
            <svg class="lcd__chart" data-lcd-chart viewBox="0 0 64 60" aria-hidden="true"></svg>
            <div class="lcd__notes" data-lcd-notes aria-hidden="true">
              {[0, 1, 2, 3, 4, 5].map(() => <span />)}
            </div>
          </div>
          <div class="chords" role="group" aria-label="Akkorde">
            {
              chords.map((c, i) => (
                <button class="key" data-chord={c} aria-pressed="false">
                  <kbd aria-hidden="true">{i + 1}</kbd>
                  {c}
                </button>
              ))
            }
          </div>
        </div>

        <div class="board__row board__row--fx">
          <div class="pedals" role="group" aria-label="Effektpedale">
            {
              pedals.map((p) => (
                <button class="stomp" data-fx={p.id} style={`--c:${p.color}`} aria-pressed="false" title={p.hint}>
                  <span class="stomp__led" aria-hidden="true" />
                  <span class="stomp__name">{p.label}</span>
                  <span class="stomp__sw" aria-hidden="true" />
                </button>
              ))
            }
          </div>
          <div class="acts" role="group" aria-label="Spielhilfen">
            <button class="key" data-strum title="Aktuellen Akkord anschlagen"><kbd aria-hidden="true">␣</kbd>Strum</button>
            <button class="key" data-riff title="Spielt ein Riff"><kbd aria-hidden="true">W</kbd>Riff</button>
            <button class="key key--solo" data-solo title="Spielt ein Solo-Lick"><kbd aria-hidden="true">Q</kbd>Solo</button>
            <button class="key" data-mute aria-pressed="false" title="Palm Mute: Saiten mit dem Handballen abdämpfen"><kbd aria-hidden="true">T</kbd>Mute</button>
            <button class="key" data-whammy title="Tremolohebel drücken, solange du hältst"><kbd aria-hidden="true">X</kbd>Dive</button>
          </div>
          <div class="jam" role="group" aria-label="Jam">
            <button class="key key--loop" data-loop data-state="idle" title="Aufnehmen, in Schleife abspielen, löschen">
              <kbd aria-hidden="true">E</kbd><span class="dot" aria-hidden="true"></span><span data-loop-label>Looper</span>
            </button>
            <button class="key key--band" data-band aria-pressed="false" title="Schlagzeug und Bass spielen mit, die Akkorde wechseln von selbst">
              <kbd aria-hidden="true">R</kbd><span class="dot" aria-hidden="true"></span>Band
            </button>
            <div class="tempo">
              <button data-tempo="-4" aria-label="Langsamer">−</button>
              <span><output data-bpm>104</output> BPM</span>
              <button data-tempo="4" aria-label="Schneller">+</button>
            </div>
          </div>
        </div>
      </div>
      <p class="board__hint">
        <span>Über die Saiten fahren = spielen</span><span>Griffbrett anklicken = einzelne Töne</span><span>Hebel und Regler ziehen</span><span>Daneben ziehen = Gitarre drehen</span>
      </p>
    </div>
  </section>

  <section class="section section--tight how">
    <div class="container">
      <ul class="how__list">
        {
          how.map(([title, text]) => (
            <li>
              <h2 class="t-m">{title}</h2>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2 story">
      <div class="stack" style="--gap:1.5rem">
        <h2 class="t-xl lt-title">Erst eine kleine Ibanez. Dann eine grössere.</h2>
        <p class="t-lead t-muted">
          Angefangen hat alles mit einer E-Gitarre, die fast so gross war wie ich, und einem Notenständer davor. Seither ist die Gitarre nicht mehr
          weggekommen.
        </p>
        <p class="t-muted">
          Heute spiele ich eine blaue Ibanez Prestige mit Tremolo, meistens laut und meistens mit Verzerrung. Am liebsten Hard Rock, Solos
          inklusive. Mein grösster Einfluss: Guns N' Roses.
        </p>
      </div>
      <div class="story__pics">
        <figure class="story__a" data-tilt="6">
          <div class="media"><Image src={kid.src} alt={kid.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 34vw" /></div>
          <figcaption>Damals</figcaption>
        </figure>
        <figure class="story__b" data-tilt="6">
          <div class="media"><Image src={studio.src} alt={studio.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 34vw" /></div>
          <figcaption>Heute, im Studio</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="band__head">
        <img src={logoUrl} alt="Logo von Los Trios" class="band__logo" width="220" height="220" />
        <div class="stack" style="--gap:1.3rem">
          <h2 class="t-page band__title lt-title">Los Trios</h2>
          <p class="t-lead">
            Hard Rock aus Andelfingen. Wir haben uns Los Trios genannt, weil wir mit drei Leuten angefangen haben. Inzwischen sind wir zu fünft,
            der Name ist geblieben.
          </p>
          <div class="btn-row">
            <a class="btn lt-btn lt-btn--solid" href={site.links.lostrios} target="_blank" rel="noopener">lostrios.ch<span class="sr-only">{neuesFenster}</span></a>
            <a class="btn lt-btn" href={site.links.lostriosSpotify} target="_blank" rel="noopener">Spotify<span class="sr-only">{neuesFenster}</span></a>
            <a class="btn lt-btn" href={site.links.lostriosInstagram} target="_blank" rel="noopener">Instagram<span class="sr-only">{neuesFenster}</span></a>
            <a class="btn lt-btn" href={site.links.lostriosYoutube} target="_blank" rel="noopener">YouTube<span class="sr-only">{neuesFenster}</span></a>
          </div>
        </div>
      </div>

      <div class="band__grid">
        <figure class="band__photo band__photo--wide" data-tilt="4">
          <div class="media"><Image src={waldhof.src} alt={waldhof.alt} widths={[700, 1100, 1600]} sizes="(max-width: 760px) 92vw, 60vw" /></div>
        </figure>
        <figure class="band__photo" data-tilt="5">
          <div class="media"><Image src={live.src} alt={live.alt} widths={[480, 800, 1000]} sizes="(max-width: 760px) 92vw, 32vw" /></div>
        </figure>
      </div>

      <div class="grid-2 band__info">
        <div>
          <h3 class="t-l">Besetzung</h3>
          <ul class="lineup">
            {
              lineup.map(([name, role]) => (
                <li class={name === 'Tim' ? 'is-me' : ''}>
                  <strong>{name}</strong>
                  <span>{role}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="t-l">Chronik</h3>
          <ol class="chronik">
            {
              chronik.map(([date, title, text]) => (
                <li>
                  <time>{date}</time>
                  <div>
                    <strong>{title}</strong>
                    <p>{text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section gear">
    <div class="container grid-2">
      <figure data-tilt="5">
        <div class="media gear__img"><Image src={head.src} alt={head.alt} widths={[600, 1000, 1600]} sizes="(max-width: 760px) 92vw, 46vw" /></div>
      </figure>
      <div class="stack" style="--gap:1.4rem">
        <h2 class="t-xl lt-title">Kopfhörer auf, Cap ins Gesicht, Take läuft.</h2>
        <p class="t-lead t-muted">
          Im Studio zählt jeder Ton. Unsere Songs nehmen wir mit Access Audio Productions auf. Nach der zweiten Session im Oktober 2026 sind
          drei neue Songs fertig.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2 class="t-l lt-title">Bühne, Studio, Bänkli</h2>
      </div>
      <Gallery items={gallery} />
    </div>
  </section>
</Base>

<script>
  import { initMusic } from '../scripts/three/music';
  const el = document.querySelector<HTMLElement>('[data-music-stage]');
  const ui = document.querySelector<HTMLElement>('[data-music-ui]');
  if (el && ui) {
    try {
      initMusic(el, ui);
    } catch (err) {
      console.warn('3D nicht verfügbar', err);
      document.documentElement.classList.add('no-webgl');
    }
  }
</script>

<style>
  /* Titelschrift der Seite: Bodoni kursiv, wie «Los Trios» im Bandlogo */
  .lt-title,
  .mhero__text h1 {
    font-family: var(--font-lostrios);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.012em;
  }
  /* Fotos: schwarz-weiss, die Farbe kommt erst beim Überfahren oder im grossen Bild */
  .media :global(img),
  .section :global(.gallery__item img) {
    filter: grayscale(1) contrast(1.12);
    transition: filter 0.7s, transform 0.9s var(--ease);
  }
  figure:hover .media :global(img),
  .section :global(.gallery__item:hover img),
  .section :global(.gallery__item:focus-visible img) {
    filter: none;
  }
  .lt-btn {
    --btn-bg: transparent;
    --btn-fg: #fff;
    box-shadow: inset 0 0 0 1.5px #fff;
  }
  .lt-btn::before {
    background: #fff;
  }
  .lt-btn:hover {
    color: #000;
  }
  .lt-btn--solid {
    --btn-bg: #fff;
    --btn-fg: #000;
  }
  .lt-btn--solid::before {
    background: #bdbdbd;
  }

  .mhero {
    position: relative;
    min-height: max(100svh, 47rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: calc(var(--nav-h) + clamp(1.2rem, 3vw, 3rem));
    padding-bottom: clamp(0.8rem, 2vw, 1.5rem);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    /* ein weisser Scheinwerfer von oben statt farbiger Lichter */
    background: radial-gradient(60% 55% at 50% 0%, rgba(255, 255, 255, 0.1), transparent 70%), var(--paper);
  }
  .mhero__where {
    font-weight: 600;
    color: var(--muted);
  }
  .mhero__top {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }
  .mhero__text {
    display: grid;
    gap: 0.9rem;
    width: fit-content;
    max-width: min(100%, 30rem);
  }
  .mhero__text h1 {
    font-size: clamp(2.8rem, min(6.6vw, 12.5vh), 6.2rem);
    line-height: 0.96;
  }
  .mhero__lead {
    color: var(--muted);
    font-size: clamp(1rem, 0.94rem + 0.42vw, 1.24rem);
    line-height: 1.45;
  }
  .mtip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 4;
    padding: 0.4em 0.75em;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.96);
    color: #000;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .mtip:global(.is-on) {
    opacity: 1;
  }

  /* ---------- Pedalboard ---------- */
  .board {
    position: relative;
    z-index: 3;
    grid-row: 3;
    display: grid;
    gap: 0.6rem;
  }
  .board__panel {
    display: grid;
    gap: 0.5rem;
    padding: 0.6rem;
    border-radius: 22px;
    background: rgba(14, 14, 14, 0.86);
    border: 1px solid var(--line);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 30px 60px -30px #000;
    cursor: default;
  }
  .board__row {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    min-width: 0;
  }
  .board__row--fx {
    justify-content: space-between;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .board__row--fx::-webkit-scrollbar,
  .chords::-webkit-scrollbar {
    display: none;
  }
  .pedals,
  .acts,
  .jam {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    flex: none;
  }

  .amp {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.2rem 0.6rem 0.9rem;
    border-radius: 14px;
    background: #fff;
    color: #000;
    text-align: left;
    transition: transform 0.4s var(--ease-spring);
  }
  .amp:active {
    transform: scale(0.95);
  }
  .amp__led {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: #5b616d;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.25);
    transition: background-color 0.2s, box-shadow 0.3s;
  }
  .amp[aria-pressed='true'] .amp__led {
    background: #000;
    box-shadow: 0 0 0 3px #fff, 0 0 0 5px #000;
  }
  .amp:not([aria-pressed='true']) {
    animation: nudge 2.4s var(--ease) infinite;
  }
  @keyframes nudge {
    0%,
    70%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    }
    85% {
      box-shadow: 0 0 0 12px rgba(255, 255, 255, 0);
    }
  }
  .amp__txt {
    display: grid;
    line-height: 1.1;
  }
  .amp__txt b {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: -0.011em;
  }
  .amp__txt i {
    font-style: normal;
    font-size: 0.75rem;
    opacity: 0.65;
  }
  .amp[aria-pressed='true'] .amp__off,
  .amp:not([aria-pressed='true']) .amp__on {
    display: none;
  }

  /* Anzeige: Akkord, Griffbild, gespielte Töne, Wellenform */
  .lcd {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: 1fr auto;
    align-items: center;
    column-gap: 0.8rem;
    row-gap: 0.25rem;
    width: 15.5rem;
    flex: none;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    border-radius: 13px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: inset 0 0 22px rgba(255, 255, 255, 0.08);
    color: #e6e6e6;
    overflow: hidden;
  }
  .lcd__scope {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.32;
  }
  .lcd__main {
    position: relative;
    display: grid;
    gap: 0.2rem;
    line-height: 1;
    min-width: 0;
  }
  .lcd__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
    white-space: nowrap;
  }
  .lcd__label :global(b) {
    color: #000;
    background: #fff;
    padding: 0.05em 0.3em;
    border-radius: 3px;
  }
  .lcd__chord {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 650;
    letter-spacing: -0.017em;
    color: #fff;
  }
  .lcd__chart {
    position: relative;
    grid-column: 2;
    grid-row: 1 / 3;
    width: 3.5rem;
    height: 3.3rem;
  }
  .lcd__notes {
    position: relative;
    display: flex;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }
  .lcd__notes span {
    min-width: 1.5em;
    text-align: center;
    padding: 0.12em 0.1em;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.12);
  }
  .lcd__notes span:global(.is-hit) {
    animation: hit 0.5s ease-out;
  }
  @keyframes hit {
    0% {
      background: #fff;
      color: #000;
      transform: translateY(-2px);
    }
  }

  .chords {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.35rem;
  }
  .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 0.75rem;
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: transform 0.35s var(--ease-spring), background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .key:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .key:active {
    transform: scale(0.93) translateY(2px);
  }
  .key[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-accent);
    border-color: transparent;
  }
  .key kbd {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    padding: 0.15em 0.42em;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.12);
    opacity: 0.8;
  }
  .key[aria-pressed='true'] kbd {
    background: rgba(0, 0, 0, 0.16);
  }
  .key--solo {
    background: #fff;
    color: #000;
    border-color: transparent;
  }
  .key--solo:hover {
    background: #cfcfcf;
  }
  .key--solo kbd {
    background: rgba(0, 0, 0, 0.14);
  }
  .key--loop {
    min-width: 8.3rem;
    justify-content: flex-start;
  }

  /* Effektpedale als kleine Bodentreter */
  .stomp {
    --c: #d6d6d6;
    display: grid;
    justify-items: center;
    align-content: space-between;
    gap: 0.28rem;
