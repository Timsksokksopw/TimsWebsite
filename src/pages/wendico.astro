---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { foto } from '../data/fotos';
import { site } from '../data/site';
import { projekte } from '../data/projekte';
import wendicoLogo from '../assets/logos/wendico.png';

const suit = foto('tim-anzug');
const cards = await Promise.all(
  projekte.map(async (p) => ({ name: p.name, tag: p.tag, url: p.url, img: (await getImage({ src: p.img, width: 960, format: 'webp' })).src })),
);

// Leistungen wie auf wendico.ch beschrieben. Preise stehen bewusst nur dort.
const leistungen = [
  {
    title: 'Websites',
    sub: 'Webdesign und Umsetzung',
    text: 'Individuelle Websites, die ein Unternehmen professionell zeigen, Vertrauen aufbauen und aus Besuchern Kunden machen.',
    href: `${site.links.wendicoLeistungen}/websites`,
  },
  {
    title: 'Software',
    sub: 'Web-Apps, Portale & SaaS',
    text: 'Individuelle Software, die Prozesse vereinfacht und manuelle Arbeit abnimmt: Web-Apps, Kundenportale und SaaS auf skalierbarer Architektur.',
    href: `${site.links.wendicoLeistungen}/software`,
  },
  {
    title: 'KI-Lösungen',
    sub: 'Integration und Automatisierung',
    text: 'Künstliche Intelligenz gezielt in Abläufe eingebaut: Chatbots, Assistenten und Automationen. Dazu Schulungen und Workshops.',
    href: `${site.links.wendicoLeistungen}/ai-solutions`,
  },
  {
    title: 'Umsatzsysteme',
    sub: 'Marketing und Vertrieb verbunden',
    text: 'Von der Landingpage über CRM und Terminbuchung bis zum automatischen Follow-up: ein durchgehender Prozess statt einzelner Tools.',
    href: `${site.links.wendicoLeistungen}/umsatzsystem`,
  },
  {
    title: 'Social Media',
    sub: 'Strategie und Betreuung',
    text: 'Redaktionsplan, Beiträge, Reels und Auswertung für Instagram, TikTok und Facebook.',
    href: `${site.links.wendicoLeistungen}/social-media`,
  },
];
---

<Base
  page="wendico"
  title="Wendico"
  description="Wendico ist die Digitalagentur von Tim Biedermann und Panat Ruangsri: Websites, Software und SaaS, KI-Lösungen, Umsatzsysteme und Social Media."
>
  <section class="page-hero">
    <div class="container whero">
      <div class="stack" style="--gap:1.4rem">
        <p class="eyebrow" data-reveal>Wendico KLG · Mitgründer & Co-CEO</p>
        <h1 class="t-page whero__title" data-reveal>
          <Image src={wendicoLogo} alt="" width={220} class="whero__logo" loading="eager" />Wendico
        </h1>
        <p class="t-lead t-muted whero__lead" data-reveal style="--d:2">
          Meine Digitalagentur. Zusammen mit Panat Ruangsri baue ich Websites, Software und SaaS-Lösungen für Unternehmen, Vereine und Marken.
        </p>
        <div class="btn-row" data-reveal style="--d:3">
          <a class="btn btn--accent" href={site.links.wendicoTermin} target="_blank" rel="noopener">30-Minuten-Erstgespräch <span class="arrow">↗</span></a>
          <a class="btn btn--ghost" href={site.links.wendico} target="_blank" rel="noopener">wendico.ch <span class="arrow">↗</span></a>
        </div>
      </div>
      <ul class="whero__facts" data-reveal style="--d:4">
        <li><strong>{projekte.length}</strong><span>Projekte umgesetzt</span></li>
        <li><strong>{leistungen.length}</strong><span>Leistungen aus einer Hand</span></li>
        <li><strong>2</strong><span>Gründer</span></li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Leistungen</p>
        <h2 class="t-xl" data-split>Was wir bauen.</h2>
      </div>
      <ol class="svc">
        {
          leistungen.map((l, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <a class="svc__row" href={l.href} target="_blank" rel="noopener">
                <span class="svc__n">0{i + 1}</span>
                <span class="svc__title">
                  <strong>{l.title}</strong>
                  <em>{l.sub}</em>
                </span>
                <span class="svc__text">{l.text}</span>
                <span class="svc__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight projects">
    <div class="carousel" data-carousel>
      <div class="container carousel__head">
        <div>
          <p class="eyebrow">Projekte</p>
          <h3 class="t-l">Gebaut mit Wendico</h3>
        </div>
        <p class="carousel__hint" aria-hidden="true">Ziehen zum Drehen · Klick öffnet die Website</p>
      </div>
      <div class="carousel__stage stage3d" data-carousel-stage data-cursor="grab" tabindex="0" aria-label="Projekt-Karussell. Mit den Pfeiltasten blättern."></div>
      <div class="container carousel__bar">
        <button class="carousel__nav" data-c-prev aria-label="Vorheriges Projekt">←</button>
        <div class="carousel__info" aria-live="polite">
          <span class="carousel__count" data-c-count>01 / {String(cards.length).padStart(2, '0')}</span>
          <strong class="t-m" data-c-title>{cards[0].name}</strong>
          <span class="chip" data-c-tag>{cards[0].tag}</span>
          <a class="link" data-c-link href={cards[0].url} target="_blank" rel="noopener"><span>{cards[0].url}</span> ↗</a>
        </div>
        <button class="carousel__nav" data-c-next aria-label="Nächstes Projekt">→</button>
      </div>
      <ul class="carousel__fallback container">
        {
          cards.map((c) => (
            <li>
              <a class="link" href={c.url} target="_blank" rel="noopener">{c.name}</a>
              <span>{c.tag}</span>
            </li>
          ))
        }
      </ul>
      <script type="application/json" data-carousel-data set:html={JSON.stringify(cards)} />
    </div>
  </section>

  <section class="section">
    <div class="container grid-2 role">
      <div class="stack" style="--gap:1.4rem">
        <p class="eyebrow" data-reveal>Meine Rolle</p>
        <h2 class="t-xl" data-split>Operativ, Finanzen, Systeme.</h2>
        <p class="t-lead t-muted" data-reveal>
          Bei Wendico kümmere ich mich darum, dass Projekte sauber laufen: Planung, Finanzen und die Technik im Hintergrund. Und ich baue selbst
          mit, vom ersten Entwurf bis zum Deployment.
        </p>
        <ul class="chips" data-reveal>
          {['Projektleitung', 'Entwicklung', 'Hosting & Betrieb', 'Finanzen'].map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
      <figure class="quote" data-tilt="5" data-reveal="scale">
        <div class="media quote__img">
          <Image src={suit.src} alt={suit.alt} widths={[480, 800, 1024]} sizes="(max-width: 760px) 92vw, 40vw" />
        </div>
        <blockquote>
          <p>«Eine Website soll nicht nur gut aussehen. Sie soll zeigen, wofür eine Marke wirklich steht.»</p>
        </blockquote>
      </figure>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <a class="cta" href={site.links.wendicoTermin} target="_blank" rel="noopener" data-reveal>
        <span class="cta__label">Projekt im Kopf?</span>
        <strong>Lass uns 30 Minuten darüber reden.</strong>
        <span class="cta__go">Erstgespräch auf wendico.ch buchen <i aria-hidden="true">↗</i></span>
      </a>
    </div>
  </section>
</Base>

<script>
  import { initCarousel, type Project } from '../scripts/three/work';

  const root = document.querySelector<HTMLElement>('[data-carousel]');
  try {
    const stageEl = root?.querySelector<HTMLElement>('[data-carousel-stage]');
    const data = root?.querySelector('[data-carousel-data]')?.textContent;
    if (root && stageEl && data) {
      const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
      initCarousel(stageEl, JSON.parse(data) as Project[], {
        title: q('[data-c-title]'),
        tag: q('[data-c-tag]'),
        link: q<HTMLAnchorElement>('[data-c-link]'),
        count: q('[data-c-count]'),
        prev: q('[data-c-prev]'),
        next: q('[data-c-next]'),
      });
      root.classList.add('is-3d');
    }
  } catch (err) {
    console.warn('3D nicht verfügbar', err);
    document.documentElement.classList.add('no-webgl');
  }
</script>

<style>
  .whero {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .whero__title {
    display: flex;
    align-items: center;
    gap: 0.22em;
  }
  .whero__logo {
    width: 0.92em;
    height: auto;
  }
  .whero__lead {
    max-width: 32em;
  }
  .whero__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    border-left: 1px solid var(--line);
    padding-left: clamp(1.2rem, 2.5vw, 2.2rem);
  }
  .whero__facts strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--accent);
  }
  .whero__facts span {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .svc {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem minmax(13rem, 0.8fr) 1.4fr auto;
    gap: 0.6rem clamp(1rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(1.2rem, 2.6vw, 2rem) clamp(0rem, 1vw, 1rem);
    border-bottom: 1px solid var(--line);
    transition: padding 0.5s var(--ease), background-color 0.4s;
  }
  .svc__row:hover,
  .svc__row:focus-visible {
    padding-inline: clamp(0.8rem, 2vw, 1.8rem);
    background: var(--card);
  }
  .svc__n {
    font-style: normal;
    font-size: 1.1rem;
    color: var(--accent);
    font-weight: 600;
  }
  .svc__title {
    display: grid;
    gap: 0.25rem;
  }
  .svc__title strong {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.7rem);
    font-weight: 620;
    letter-spacing: -0.022em;
    line-height: 1;
  }
  .svc__title em {
    font-size: 1.02rem;
    color: var(--muted);
    font-weight: 600;
  }
  .svc__text {
    color: var(--muted);
    max-width: 34em;
  }
  .svc__arrow {
    font-size: 1.5rem;
    transition: transform 0.5s var(--ease-spring), color 0.3s;
  }
  .svc__row:hover .svc__arrow {
    transform: translate(0.2em, -0.2em);
    color: var(--accent);
  }

  .projects {
    background: var(--card);
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .projects .carousel {
    margin-top: 0;
  }
  .quote {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: #07070a;
    color: #fff;
    max-width: 30rem;
    justify-self: end;
  }
  .quote__img {
    border-radius: 0;
    aspect-ratio: 1;
  }
  .quote blockquote {
    margin: 0;
    padding: clamp(1.2rem, 2.4vw, 2rem);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.9vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.014em;
    line-height: 1.18;
  }

  .carousel {
    margin-top: clamp(3.5rem, 8vw, 7rem);
  }
  .carousel__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .carousel__head .eyebrow {
    margin-bottom: 0.8rem;
  }
  .carousel__hint {
    font-size: 0.86rem;
    color: var(--muted);
    font-weight: 600;
  }
  .carousel__stage {
    position: relative;
    inset: auto;
    height: clamp(17rem, 36vw, 27rem);
    cursor: grab;
    touch-action: pan-y;
    display: none;
  }
  .carousel:global(.is-3d) .carousel__stage {
    display: block;
  }
  .carousel__stage:global(.is-dragging) {
    cursor: grabbing;
  }
  .carousel__bar {
    display: none;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 3vw, 2.5rem);
  }
  .carousel:global(.is-3d) .carousel__bar {
    display: flex;
  }
  .carousel__info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    min-width: min(100%, 28rem);
    text-align: center;
  }
  .carousel__count {
    font-size: 0.86rem;
    color: var(--muted);
    flex-basis: 100%;
    font-weight: 600;
  }
  .carousel__nav {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    font-size: 1.2rem;
    flex: none;
    transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease-spring);
  }
  .carousel__nav:hover {
    background: var(--ink);
    color: var(--paper);
    transform: scale(1.08);
  }
  .carousel__fallback {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.8rem 2rem;
  }
  .carousel__fallback span {
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }
  .carousel:global(.is-3d) .carousel__fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .cta {
    display: grid;
    gap: 0.6rem;
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius);
    background: #0f1012;
    color: #f3efe6;
    transition: transform 0.6s var(--ease);
  }
  .cta:hover {
    transform: translateY(-4px);
  }
  .cta__label {
    font-style: normal;
    font-size: 1.25rem;
    color: #d9a94e;
    font-weight: 600;
  }
  .cta strong {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.4vw, 4.6rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1;
    max-width: 14em;
  }
  .cta__go {
    margin-top: 0.8rem;
    font-weight: 600;
    color: #d9a94e;
  }
  .cta__go i {
    font-style: normal;
    display: inline-block;
    transition: transform 0.5s var(--ease-spring);
  }
  .cta:hover .cta__go i {
    transform: translate(0.2em, -0.2em);
  }

  @media (max-width: 900px) {
    .whero {
      grid-template-columns: 1fr;
    }
    .whero__facts {
      grid-template-columns: repeat(3, 1fr);
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 1.2rem;
    }
    .svc__row {
      grid-template-columns: 2.4rem 1fr auto;
    }
    .svc__text {
      grid-column: 2 / -1;
    }
    .quote {
      justify-self: start;
    }
  }
</style>
