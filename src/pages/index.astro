---
// Startseite «Türen in die Welten»: das Gitarrenfoto als Einstieg, danach je eine Tür pro Welt
// (Swisscom, Wendico, Los Trios, Sport). Jede Tür trägt schon Farben und Schrift ihrer Unterseite.
// Beim Scrollen schiebt sich die nächste Tür über die vorherige.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/libre-bodoni/wght-italic.css';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { foto } from '../data/fotos';
import { site } from '../data/site';
import wendicoLogo from '../assets/logos/wendico.png';
import lostriosLogo from '../assets/logos/lostrios.svg?url';

const heroFoto = foto('akustik-im-weinland');
const portrait = foto('tim-portrait');
const alp = foto('wandern-tal');
const band = foto('waldhof-live');
const gipfel = foto('snowboard-duo');

// [Datum für Maschinen, Datum sichtbar, Satz, Ziel], neueste zuerst
const notizen = [
  ['2026-11', 'Nov 2026', 'Die Website für Mini Tank ist live.', '/wendico/'],
  ['2026-10', 'Okt 2026', 'Zwei Tage im Studio, drei neue Songs aufgenommen.', '/musik/'],
  ['2026-08', 'Aug 2026', 'Start ins vierte und letzte Lehrjahr.', '/arbeit/'],
];
const neuesFenster = ' (öffnet neues Fenster)';
---

<Base page="home" world="home">
  <section class="hero" data-hero data-nav-tone="dark">
    <Image class="hero__img" src={heroFoto.src} alt="Akustikgitarre auf einer Holzbank, dahinter Hügel im Abendlicht" widths={[800, 1200, heroFoto.src.width]} sizes="100vw" quality={84} loading="eager" fetchpriority="high" />
    <div class="stage3d hero__gl" data-hero-gl></div>
    <p class="hero__word" aria-hidden="true">Biedermann</p>

    <div class="hero__text">
      <h1 class="hero__name">Tim Biedermann</h1>
      <p class="hero__lead">Gründer der Digitalagentur Wendico, Plattformentwickler bei Swisscom und Lead-Gitarrist bei Los Trios.</p>
      <div class="btn-row">
        <a class="btn hero__btn" href={site.links.wendicoTermin} target="_blank" rel="noopener">Projekt anfragen<span class="sr-only">{neuesFenster}</span></a>
        <a class="btn hero__btn hero__btn--glass" href="/ueber-mich/">Mehr über mich</a>
      </div>
    </div>
    <p class="hero__caption" aria-hidden="true">Gitarre, Bänkli, Abendlicht.</p>
  </section>

  <section class="intro">
    <div class="container intro__row">
      <h2 class="intro__title">Wo du mich findest.</h2>
      <!-- Jede Welt in ihrer eigenen Schrift: ein Vorgeschmack auf die Türen darunter -->
      <nav class="intro__worlds" aria-label="Meine vier Welten">
        <a href="#swisscom" class="world world--swisscom">Swisscom</a>
        <a href="#wendico" class="world world--wendico">Wendico</a>
        <a href="#los-trios" class="world world--lostrios">Los Trios</a>
        <a href="#sport" class="world world--sport">Sport</a>
      </nav>
    </div>
  </section>

  <div class="doors" data-doors>
    <!-- Tür 1: Swisscom. Ruhig, Weiss und Navy, klares Raster. Bewusst ohne Swisscom-Logo. -->
    <section class="door door--swisscom" id="swisscom" aria-labelledby="tuer-swisscom">
      <div class="container sc">
        <div class="sc__copy">
          <p class="sc__world">Swisscom</p>
          <h2 class="sc__title" id="tuer-swisscom">Plattformen, die einfach laufen.</h2>
          <p class="sc__text">Lehre als Informatiker EFZ, Fachrichtung Plattformentwicklung, im vierten und letzten Lehrjahr. Daneben die Berufsmatura an der TBZ.</p>
          <ul class="sc__facts">
            <li><strong>4.</strong><span>Lehrjahr</span></li>
            <li><strong>5</strong><span>Stationen</span></li>
            <li><strong>BM</strong><span>Berufsmatura</span></li>
          </ul>
          <a class="btn sc__btn" href="/arbeit/">Zu meiner Lehre</a>
        </div>
        <figure class="sc__photo" data-tilt="3">
          <Image src={portrait.src} alt="Tim Biedermann lacht in die Kamera, im dunkelblauen Pullover" widths={[480, 800, 1100]} sizes="(max-width: 900px) 92vw, 40vw" />
        </figure>
      </div>
    </section>

    <!-- Tür 2: Wendico. Waldgrün, Lime, Manrope und DM Sans wie auf wendico.ch. -->
    <section class="door door--wendico" id="wendico" aria-labelledby="tuer-wendico">
      <div class="wd">
        <Image class="wd__bg" src={alp.src} alt="" widths={[800, 1200, 1600]} sizes="100vw" />
        <div class="wd__content">
          <span class="wd__logo"><Image src={wendicoLogo} alt="Wendico" width={96} /></span>
          <h2 class="wd__title" id="tuer-wendico">
            <span>Websites, Software und KI.</span>
            <span>Für Firmen, die wachsen wollen.</span>
          </h2>
          <p class="wd__text">Wendico habe ich mit Panat Ruangsri gegründet. Wir bauen Websites, Software, KI-Lösungen und Umsatzsysteme für Unternehmen in der Schweiz.</p>
          <div class="btn-row">
            <a class="btn wd__btn" href="/wendico/">Zur Wendico-Seite</a>
            <a class="btn wd__btn wd__btn--ghost" href={site.links.wendicoTermin} target="_blank" rel="noopener">30-Minuten-Erstgespräch buchen<span class="sr-only">{neuesFenster}</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Tür 3: Los Trios. Nur Schwarz und Weiss, Plektrum-Logo, Bodoni wie im Bandlogo. -->
    <section class="door door--lostrios" id="los-trios" aria-labelledby="tuer-lostrios" data-nav-tone="dark">
      <div class="lt__photo">
        <Image src={band.src} alt={band.alt} widths={[700, 1100, 1600]} sizes="(max-width: 900px) 100vw, 60vw" />
      </div>
      <div class="lt__copy">
        <img class="lt__logo" src={lostriosLogo} alt="Los Trios" width="208" height="208" loading="lazy" decoding="async" />
        <h2 class="lt__title" id="tuer-lostrios">Ich spiele die Solos.</h2>
        <p class="lt__text">Lead-Gitarre bei Los Trios, Spitzname Bobby. Auf der Musikseite steht eine Gitarre, die du selber spielen kannst.</p>
        <a class="btn lt__btn" href="/musik/">Gitarre spielen</a>
      </div>
    </section>

    <!-- Tür 4: Sport. Weiss, schmale fette Schrift und das Orange vom Ski-Helm. -->
    <section class="door door--sport" id="sport" aria-labelledby="tuer-sport">
      <div class="container sp">
        <div class="sp__copy">
          <h2 class="sp__word" id="tuer-sport">Raus<br />hier.</h2>
          <ul class="sp__facts">
            <li><strong>6</strong><span>Sportarten</span></li>
            <li><strong>5. Liga</strong><span>Tischtennis beim TTC Neuhausen</span></li>
          </ul>
          <p class="sp__text">Ski, Tischtennis, Golf, Mountainbike, Laufen und Wandern. Hauptsache draussen.</p>
          <a class="btn sp__btn" href="/sport/">Zur Sport-Seite</a>
        </div>
        <figure class="sp__photo" data-tilt="3">
          <Image src={gipfel.src} alt="Tim mit orangem Ski-Helm und ein Freund jubeln auf einem verschneiten Gipfel" widths={[480, 800, 1100]} sizes="(max-width: 900px) 92vw, 38vw" />
        </figure>
      </div>
    </section>
  </div>

  <section class="after">
    <div class="container after__grid">
      <div>
        <h2 class="after__title">Gerade aktuell</h2>
        <ul class="notes">
          {
            notizen.map(([iso, date, text, href]) => (
              <li>
                <a href={href}>
                  <time datetime={iso}>{date}</time>
                  <span>{text}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <a class="cta" href={site.links.wendicoTermin} target="_blank" rel="noopener">
        <span class="cta__label">Projekt im Kopf?</span>
        <strong>Lass uns 30 Minuten darüber reden.</strong>
        <span class="btn cta__go">Erstgespräch auf wendico.ch buchen<span class="sr-only">{neuesFenster}</span></span>
      </a>
    </div>
  </section>
</Base>

<script>
  import { initHero } from '../scripts/three/hero';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const heroGl = document.querySelector<HTMLElement>('[data-hero-gl]');
  const heroImg = hero?.querySelector<HTMLImageElement>('.hero__img');
  if (hero && heroGl && heroImg) {
    try {
      // das <img> des Fotos ist zugleich die Textur für den Glas-Effekt
      initHero(heroGl, hero, { photo: heroImg, word: 'BIEDERMANN', focus: [0.5, 0.43], focusNarrow: [0.4, 0.5] });
    } catch (err) {
      console.warn('3D nicht verfügbar', err);
    }
  }

  // Türen stapeln: Jede Tür bleibt oben stehen, die nächste schiebt sich darüber.
  // Ist eine Tür höher als das Fenster (Handy), bleibt sie erst stehen, wenn ihr unteres Ende erreicht ist.
  const doors = document.querySelector<HTMLElement>('[data-doors]');
  if (doors && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(doors.querySelectorAll<HTMLElement>('.door'));
    const measure = () => items.forEach((d) => d.style.setProperty('--door-h', `${d.offsetHeight}px`));
    measure();
    new ResizeObserver(measure).observe(doors);
    doors.classList.add('is-stack');
  }
</script>

<style>
  /* ---------- Einstieg: das Gitarrenfoto im Rahmen ---------- */
  .hero {
    --frame: clamp(0.4rem, 0.9vw, 0.8rem);
    position: relative;
    margin: var(--frame);
    height: calc(100svh - 2 * var(--frame));
    min-height: 34rem;
    border-radius: clamp(18px, 2vw, 30px);
    overflow: hidden;
    background: var(--paper-2);
    display: grid;
    align-items: end;
    isolation: isolate;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 43%;
    z-index: -2;
  }
  .hero__gl {
    z-index: -1;
    opacity: 0;
    transition: opacity 0.8s;
  }
  .hero:global(.is-gl) .hero__gl {
    opacity: 1;
  }
  /* Schriftzug ohne WebGL: schlicht durchscheinend */
  .hero__word {
    position: absolute;
    top: 10%;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 15.4vw;
    line-height: 1;
    letter-spacing: -0.019em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    pointer-events: none;
    z-index: -1;
  }
  .hero:global(.is-gl) .hero__word {
    display: none;
  }
  /* Damit Text und Leiste ohne Kasten lesbar bleiben: weiche Schatten nur an den Bildrändern */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .hero::before {
    inset: 0 0 82% 0;
    background: linear-gradient(to bottom, rgba(10, 12, 16, 0.34), transparent);
  }
  .hero::after {
    inset: 48% 0 0 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.66) 0%, rgba(10, 12, 16, 0.3) 45%, transparent 100%);
  }
  .hero__text {
    padding: clamp(1.2rem, 3.4vw, 3.4rem);
    max-width: 46rem;
    display: grid;
    gap: clamp(0.8rem, 1.4vw, 1.2rem);
    color: #fff;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.4);
  }
  .hero__name {
    font-size: clamp(2.6rem, 6.2vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 0.98;
  }
  .hero__lead {
    max-width: 32em;
    font-size: clamp(1.05rem, 0.98rem + 0.45vw, 1.35rem);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.94);
  }
  .hero__btn {
    --btn-bg: #fff;
    --btn-fg: #16181d;
    text-shadow: none;
  }
  .hero__btn::before {
    background: #16181d;
  }
  .hero__btn:hover {
    color: #fff;
  }
  .hero__btn--glass {
    --btn-bg: rgba(255, 255, 255, 0.14);
    --btn-fg: #fff;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .hero__btn--glass::before {
    background: #fff;
  }
  .hero__btn--glass:hover {
    color: #16181d;
  }
  .hero__caption {
    position: absolute;
    right: clamp(1rem, 2.4vw, 2rem);
    bottom: clamp(1rem, 2.4vw, 2rem);
    font-size: 1rem;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-weight: 600;
  }

  /* ---------- Auftakt zu den Türen ---------- */
  .intro {
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .intro__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem 3rem;
  }
  .intro__title {
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .intro__worlds {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem clamp(1.2rem, 2.6vw, 2.4rem);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
  }
  .world {
    line-height: 1.25;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .world:hover,
  .world:focus-visible {
    background-size: 100% 2px;
  }
  .world--swisscom {
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #001155;
  }
  .world--wendico {
    font-family: var(--font-wendico);
    font-weight: 500;
    color: #176b4b;
  }
  .world--lostrios {
    font-family: var(--font-lostrios);
    font-style: italic;
    font-weight: 700;
    color: #000;
  }
  .world--sport {
    font-family: var(--font-sport);
    font-stretch: 62%;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.12em;
    color: var(--orange-deep);
  }

  /* ---------- Türen: gemeinsames Gerüst ---------- */
  .door {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
  }
  .doors:global(.is-stack) .door {
    position: sticky;
    top: min(0px, calc(100svh - var(--door-h, 100svh)));
  }
  /* die nachrückende Tür: oben abgerundet, mit weichem Schatten auf die Tür darunter */
  .door + .door {
    border-radius: var(--radius) var(--radius) 0 0;
    box-shadow: 0 -22px 60px -28px rgba(0, 0, 0, 0.35);
  }

  /* ---------- Tür 1: Swisscom ---------- */
  .door--swisscom {
    --sc-navy: #001155;
    --sc-blue: #0445c8;
    --sc-line: #d9dee7;
    background: #fff;
    color: #1f1e23;
    padding-block: clamp(4.5rem, 10svh, 7rem);
  }
  .sc {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .sc__world {
    font-weight: 700;
    color: var(--sc-navy);
  }
  .sc__title {
    margin-top: 0.7rem;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.022em;
    line-height: 1.06;
    color: var(--sc-navy);
  }
  .sc__text {
    margin-top: 1.4rem;
    max-width: 33em;
    font-size: 1.125rem;
    line-height: 1.55;
  }
  .sc__facts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 33rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--sc-line);
    border-radius: 20px;
  }
  .sc__facts li {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem;
  }
  .sc__facts li + li {
    border-left: 1px solid var(--sc-line);
  }
  .sc__facts strong {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--sc-navy);
  }
  .sc__facts span {
    font-size: 0.94rem;
    color: #555;
  }
  .sc__btn {
    --btn-bg: var(--sc-blue);
    --btn-fg: #fff;
    margin-top: 2rem;
  }
  .sc__btn::before {
    background: var(--sc-navy);
  }
  .sc__btn:hover {
    color: #fff;
  }
  .sc__photo {
    position: relative;
    justify-self: end;
    width: 100%;
    max-height: 76svh;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: #f3f5f8;
  }
  .sc__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 24%;
  }

  /* ---------- Tür 2: Wendico ---------- */
  .door--wendico {
    --wd-pad: clamp(0.6rem, 1.8vw, 1.8rem);
    background: #f4f7f4;
    padding: var(--wd-pad);
    font-family: var(--font-wendico-body);
  }
  .wd {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 2 * var(--wd-pad));
    display: grid;
    align-items: end;
    border-radius: clamp(22px, 3vw, 40px);
    overflow: hidden;
    color: #fff;
    background: #14231d;
    box-shadow: rgba(26, 47, 38, 0.2) 0 30px 65px;
  }
  .wd__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease);
  }
  .door--wendico:hover .wd__bg {
    transform: scale(1.03);
  }
  /* Waldgrüner Schleier: links dicht für den Text, rechts bleibt das Tal sichtbar */
  .wd::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(13, 34, 26, 0.94) 0%, rgba(14, 58, 42, 0.8) 46%, rgba(14, 58, 42, 0.3) 100%);
  }
  .wd__content {
    display: grid;
    justify-items: start;
    gap: clamp(1.1rem, 2vw, 1.6rem);
    padding: clamp(1.5rem, 5vw, 5rem);
  }
  .wd__logo {
    display: inline-flex;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: #fff;
  }
  .wd__logo :global(img) {
    height: 1.7rem;
    width: auto;
  }
  .wd__title {
    font-family: var(--font-wendico);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.4vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    /* zwei Zeilen wie auf wendico.ch: erst die Aussage, dann die Pointe */
    max-width: 68rem;
    text-wrap: initial;
  }
  .wd__title span {
    display: block;
  }
  .wd__title span + span {
    color: rgba(255, 255, 255, 0.72);
  }
  .wd__text {
    max-width: 35em;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
  }
  .wd__btn {
    --btn-bg: #d8ff71;
    --btn-fg: #14231d;
  }
  .wd__btn::before {
    background: #fff;
  }
  .wd__btn:hover {
    color: #14231d;
  }
  .wd__btn--ghost {
    --btn-bg: rgba(255, 255, 255, 0.1);
    --btn-fg: #fff;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ---------- Tür 3: Los Trios ---------- */
  .door--lostrios {
    background: #000;
    color: #fff;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: stretch;
    overflow: hidden;
  }
  .lt__photo {
    position: relative;
    min-height: 56svh;
    overflow: hidden;
  }
  .lt__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    /* die Band gibt es hier nur in Schwarz-Weiss, wie ihr Logo */
    filter: grayscale(1) contrast(1.25);
    transition: transform 1.6s var(--ease);
  }
  .door--lostrios:hover .lt__photo :global(img) {
    transform: scale(1.04);
  }
  .lt__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: clamp(1.1rem, 2vw, 1.6rem);
    padding: clamp(2rem, 5vw, 5rem);
  }
  .lt__logo {
    width: clamp(8.5rem, 13vw, 13rem);
    height: auto;
    margin-left: -0.6rem;
  }
  .lt__title {
    font-family: var(--font-lostrios);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.4rem, 4.6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .lt__text {
    max-width: 27em;
    color: #a6a6a6;
  }
  .lt__btn {
    --btn-bg: transparent;
    --btn-fg: #fff;
    box-shadow: inset 0 0 0 1.5px #fff;
  }
  .lt__btn::before {
    background: #fff;
  }
  .lt__btn:hover {
    color: #000;
  }

  /* ---------- Tür 4: Sport ---------- */
  .door--sport {
    background: #fff;
    color: #111;
    padding-block: clamp(4.5rem, 10svh, 7rem);
  }
  .sp {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .sp__word {
