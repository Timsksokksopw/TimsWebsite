---
// Sport-Seite: Weiss, schmale fette Schrift und das Orange vom Ski-Helm.
// Einstieg mit dem drehbaren Berg vor dem Wort der Jahreszeit, dann die Sportarten als grosse Blöcke.
// Tischtennis bekommt den orangen Block mit dem Spiel.
import '@fontsource-variable/archivo/wdth.css';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { fotos, foto } from '../data/fotos';
import { site } from '../data/site';

const gallery = [...fotos('sport'), foto('hund-auf-der-alp')];
const ski = foto('snowboard-nebelmeer');

// Die vier kleineren Blöcke. Ohne Foto (img: null) wird der Block dunkel.
const blocks = [
  {
    title: 'Golf', season: 'Sommer', img: foto('golf-range'), pos: '50% 28%',
    text: 'Auf der Driving Range Bälle schlagen, bis der Korb leer ist. Und dann noch einen Korb.',
  },
  {
    title: 'Laufen', season: 'Ganzes Jahr', img: foto('laufen'), pos: '60% 78%',
    text: 'Laufschuhe an und los, am liebsten über Kieswege und durch den Wald. Kopf lüften nach einem Tag am Bildschirm.',
  },
  {
    title: 'Mountainbike', season: 'Sommer', img: null, pos: '',
    text: 'Mit dem Bike durchs Weinland, über Feldwege und durch den Wald. Unter der Woche reicht es immerhin für die Strecke zum Bahnhof.',
  },
  {
    title: 'Wandern', season: 'Sommer', img: foto('wandern-tal'), pos: '50% 50%',
    text: 'Im Sommer geht es in die Berge. Weite Täler, Wasserfälle und zwischendurch vierbeinige Begleitung.',
  },
];
---

<Base
  page="sport"
  world="sport"
  title="Sport"
  description="Ski, Tischtennis, Golf, Mountainbike, Laufen und Wandern: So hält sich Tim Biedermann in Bewegung."
>
  <section class="shero" data-season="winter" data-sport-hero>
    <!-- das Wort der Jahreszeit steht hinter dem Berg und wechselt mit dem Schalter -->
    <p class="shero__word" aria-hidden="true">
      <span data-word="winter">Winter</span>
      <span data-word="sommer">Sommer</span>
    </p>
    <div class="stage3d shero__stage" data-mountain data-cursor="grab"></div>
    <div class="shero__text">
      <h1 class="shero__title">Raus hier.</h1>
      <p class="shero__lead">
        <span data-lead="winter">Im Winter auf den Ski, sobald irgendwo Schnee liegt.</span>
        <span data-lead="sommer">Im Sommer zu Fuss, auf dem Bike oder auf der Driving Range.</span>
      </p>
      <div class="season" role="group" aria-label="Jahreszeit wählen">
        <button data-season-btn="winter" aria-pressed="true">Winter</button>
        <button data-season-btn="sommer" aria-pressed="false">Sommer</button>
        <span class="season__thumb" aria-hidden="true"></span>
      </div>
    </div>
    <p class="shero__hint" aria-hidden="true">Berg drehen. Der mit dem orangen Helm bin ich.</p>
  </section>

  <section class="why">
    <div class="container why__grid">
      <h2 class="why__title">Ich sitze beruflich genug. Der Rest ist Bewegung.</h2>
      <p class="why__text">Sechs Sportarten, verteilt über das ganze Jahr. Hauptsache draussen, und nach einem Tag am Bildschirm den Kopf lüften.</p>
    </div>
  </section>

  <section class="facts" data-nav-tone="dark" aria-label="In Zahlen">
    <ul class="container facts__row">
      <li><strong>6</strong><span>Sportarten</span></li>
      <li><strong>5. Liga</strong><span>Tischtennis beim TTC Neuhausen</span></li>
    </ul>
  </section>

  <section class="blocks">
    <div class="container blocks__grid">
      <h2 class="sr-only">Meine Sportarten</h2>

      <article class="block block--wide">
        <Image class="block__img" src={ski.src} alt="" widths={[800, 1280, 1600]} sizes="(max-width: 1340px) 94vw, 1280px" style="object-position:50% 58%" />
        <div class="block__body">
          <h3 class="block__title">Ski</h3>
          <p class="block__text">Im Winter stehe ich auf den Ski, am liebsten bei Sonne über dem Nebelmeer. Das Snowboard habe ich auch schon ausprobiert. Beweisfotos gibt es unten in der Galerie.</p>
          <p class="block__season">Winter</p>
        </div>
      </article>

      {
        blocks.map((b) => (
          <article class:list={['block', !b.img && 'block--plain']} data-tilt="3">
            {b.img && <Image class="block__img" src={b.img.src} alt="" widths={[480, 800, 1100]} sizes="(max-width: 760px) 94vw, 46vw" style={`object-position:${b.pos}`} />}
            <div class="block__body">
              <h3 class="block__title">{b.title}</h3>
              <p class="block__text">{b.text}</p>
              <p class="block__season">{b.season}</p>
            </div>
          </article>
        ))
      }

      <!-- Tischtennis: der einzige Sport mit Liga, deshalb mit eigenem Block und einem Spiel -->
      <article class="tt">
        <div class="tt__info">
          <h3 class="tt__title">Tischtennis</h3>
          <div class="tt__copy">
            <p>Seit ein paar Jahren an der Platte. Ich spiele mit dem TTC Neuhausen in der 5. Liga und habe nebenbei auch die Website des Clubs gebaut.</p>
            <p class="tt__meta">
              <a class="link" href={site.links.ttc} target="_blank" rel="noopener">ttc-neuhausen.ch<span class="sr-only"> (öffnet neues Fenster)</span></a>
              <span>Ganzes Jahr</span>
            </p>
          </div>
        </div>
        <div class="game" data-pp>
          <div class="game__score" aria-hidden="true"><span data-pp-score>0</span></div>
          <div class="stage3d" data-pp-stage></div>
          <h4 class="game__title">Halt den Ball oben.</h4>
          <p class="game__best">Rekord <b data-pp-best>0</b></p>
          <div class="game__overlay" data-pp-overlay>
            <p data-pp-msg>Beweg den Schläger mit der Maus oder dem Finger.</p>
            <button class="btn game__btn" data-pp-start>Los geht's</button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="gal">
    <div class="container">
      <h2 class="gal__title">Schnee, Gras und Kies</h2>
      <Gallery items={gallery} />
    </div>
  </section>
</Base>

<script>
  import { initMountain, type Season } from '../scripts/three/mountain';
  import { initPingPong } from '../scripts/three/pingpong';

  const hero = document.querySelector<HTMLElement>('[data-sport-hero]');
  const mEl = document.querySelector<HTMLElement>('[data-mountain]');
  const month = new Date().getMonth();
  let season: Season = month >= 4 && month <= 9 ? 'sommer' : 'winter';
  let mountain: ReturnType<typeof initMountain> | null = null;

  const setSeason = (s: Season) => {
    season = s;
    hero?.setAttribute('data-season', s);
    document.querySelectorAll<HTMLButtonElement>('[data-season-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.seasonBtn === s)));
    mountain?.setSeason(s);
  };
  try {
    if (mEl) mountain = initMountain(mEl, season);
  } catch (err) {
    console.warn('3D nicht verfügbar', err);
    document.documentElement.classList.add('no-webgl');
  }
  setSeason(season);
  document.querySelectorAll<HTMLButtonElement>('[data-season-btn]').forEach((b) => b.addEventListener('click', () => setSeason(b.dataset.seasonBtn as Season)));

  const pp = document.querySelector<HTMLElement>('[data-pp]');
  const ppStage = document.querySelector<HTMLElement>('[data-pp-stage]');
  if (pp && ppStage) {
    try {
      initPingPong(ppStage, pp);
    } catch (err) {
      // kein WebGL: der Block zeigt nur den Text zum Tischtennis
      console.warn('Spiel nicht verfügbar', err);
      pp.hidden = true;
    }
  }
</script>

<style>
  /* gemeinsame Display-Schrift der Seite: Archivo, schmal und fett */
  .shero__word,
  .shero__title,
  .facts strong,
  .block__title,
  .tt__title,
  .game__title,
  .game__score {
    font-family: var(--font-sport);
    font-stretch: 62%;
    font-weight: 900;
    text-transform: uppercase;
  }

  /* ---------- Einstieg: der Berg vor dem Wort der Jahreszeit ---------- */
  .shero {
    --frame: clamp(0.4rem, 0.9vw, 0.8rem);
    --edge: clamp(1.2rem, 3.4vw, 3.2rem);
    position: relative;
    isolation: isolate;
    margin: var(--frame);
    height: calc(100svh - 2 * var(--frame));
    min-height: 36rem;
    border-radius: clamp(18px, 2vw, 30px);
    overflow: hidden;
    background: var(--paper-2);
  }
  /* --peak-y setzt die 3D-Szene: die Höhe des Gipfels im Bild. Das Wort steht so, dass der Gipfel hineinragt. */
  .shero__word {
    position: absolute;
    inset: calc(var(--peak-y, 26%) - 0.4em) 0 auto 0;
    z-index: 0;
    margin: 0;
    display: grid;
    justify-items: center;
    font-size: min(26vw, 46svh);
    line-height: 0.8;
    color: var(--orange);
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .shero__word span {
    grid-area: 1 / 1;
    transition: opacity 0.7s, transform 0.9s var(--ease);
  }
  .shero[data-season='winter'] [data-word='sommer'],
  .shero[data-season='sommer'] [data-word='winter'] {
    opacity: 0;
    transform: translateY(10%);
  }
  .shero__stage {
    z-index: 1;
    cursor: grab;
    touch-action: pan-y;
  }
  .shero__stage:global(.is-dragging) {
    cursor: grabbing;
  }
  .shero__text {
    position: absolute;
    left: var(--edge);
    bottom: var(--edge);
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    max-width: 21rem;
    pointer-events: none;
  }
  .shero__title {
    font-size: clamp(3.2rem, 5.6vw, 5.2rem);
    line-height: 0.88;
  }
  .shero__lead {
    display: grid;
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .shero__lead span {
    grid-area: 1 / 1;
    transition: opacity 0.6s, transform 0.8s var(--ease);
  }
  .shero[data-season='winter'] [data-lead='sommer'],
  .shero[data-season='sommer'] [data-lead='winter'] {
    opacity: 0;
    transform: translateY(12px);
  }
  .season {
    pointer-events: auto;
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 0.3rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .season button {
    position: relative;
    z-index: 1;
    padding: 0.7em 1.4em;
    border-radius: 999px;
    font-weight: 600;
    white-space: nowrap;
  }
  .season__thumb {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0.3rem;
    width: calc(50% - 0.3rem);
    border-radius: 999px;
    background: var(--orange);
    transition: transform 0.6s var(--ease-spring);
  }
  .shero[data-season='sommer'] .season__thumb {
    transform: translateX(100%);
  }
  .shero__hint {
    position: absolute;
    right: var(--edge);
    bottom: var(--edge);
    z-index: 2;
    max-width: 13em;
    text-align: right;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
    pointer-events: none;
  }
  :global(.no-webgl) .shero__hint {
    display: none;
  }

  /* ---------- Motivation ---------- */
  .why {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .why__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
  }
  .why__title {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.04;
  }
  .why__text {
    max-width: 28em;
    font-size: 1.125rem;
    color: var(--muted);
  }

  /* ---------- Zahlen ---------- */
  .facts {
    background: #111;
    color: #fff;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .facts__row {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
  }
  .facts__row li {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .facts__row li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .facts strong {
    font-size: clamp(4rem, 11vw, 10rem);
    line-height: 0.85;
    color: var(--orange);
  }
  .facts span {
    font-weight: 500;
  }

  /* ---------- Sportarten als Blöcke ---------- */
  .blocks {
    padding-block: clamp(3.5rem, 8vw, 7rem) 0;
  }
  .blocks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.6vw, 1.4rem);
  }
  .block {
    position: relative;
    isolation: isolate;
    min-height: clamp(19rem, 31vw, 27rem);
    display: grid;
    align-items: end;
    border-radius: 28px;
    overflow: hidden;
    background: #111;
    color: #fff;
  }
  .block--wide {
    grid-column: 1 / -1;
    min-height: clamp(24rem, 46vw, 38rem);
  }
  .block__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .block:hover .block__img {
    transform: scale(1.05);
  }
  /* dunkler Verlauf nur unten, damit die weisse Schrift auf jedem Foto lesbar ist */
  .block::before {
    content: '';
    position: absolute;
    inset: 30% 0 0 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.5) 45%, transparent 100%);
  }
  .block--plain::before {
    display: none;
  }
  .block__body {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.3rem, 2.8vw, 2.6rem);
  }
  .block__title {
    font-size: clamp(2.8rem, 5.2vw, 5rem);
    line-height: 0.9;
  }
  .block--wide .block__title {
    font-size: clamp(4.5rem, 12vw, 11rem);
    line-height: 0.82;
  }
  .block__text {
    max-width: 31em;
    font-size: 1.04rem;
    line-height: 1.5;
  }
  .block__season {
    font-size: 0.92rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.76);
  }

  /* ---------- Tischtennis mit Spiel ---------- */
  .tt {
    grid-column: 1 / -1;
    border-radius: 28px;
    overflow: hidden;
    background: var(--orange);
    color: #111;
  }
  .tt__info {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: end;
    padding: clamp(1.3rem, 2.8vw, 2.6rem);
  }
  /* «Tischtennis» ist das längste Wort der Seite: die Grösse richtet sich nach der Spaltenbreite */
  .tt__title {
    font-size: clamp(3.2rem, 8.4vw, 8rem);
    line-height: 0.82;
    color: #fff;
  }
  .tt__copy {
    display: grid;
    gap: 0.8rem;
    font-size: 1.04rem;
    line-height: 1.5;
  }
  .tt__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    font-weight: 600;
  }
  .tt__meta span {
    font-weight: 500;
  }
  .tt .link:hover {
    color: #fff;
  }
  .game {
    position: relative;
    height: clamp(24rem, 58vh, 34rem);
    border-top: 1px solid rgba(17, 17, 17, 0.16);
    overflow: hidden;
    touch-action: none;
    cursor: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .game__title {
    position: absolute;
    top: clamp(1.2rem, 2.5vw, 2rem);
    left: clamp(1.3rem, 2.8vw, 2.6rem);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 0.9;
    color: #fff;
    pointer-events: none;
  }
  .game__best {
    position: absolute;
    top: clamp(1.2rem, 2.5vw, 2rem);
    right: clamp(1.3rem, 2.8vw, 2.6rem);
    font-weight: 600;
    pointer-events: none;
  }
  .game__best b {
    margin-left: 0.3rem;
    font-size: 1.15rem;
  }
  .game__score {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(11rem, 30vw, 24rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.34);
    pointer-events: none;
  }
  .game__score span {
    display: inline-block;
  }
  .game__score :global(.is-pop) {
    animation: pop 0.35s var(--ease-spring);
  }
  @keyframes pop {
    0% {
      transform: scale(1.18);
      color: #fff;
    }
  }
  .game__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1.2rem, 2.5vw, 2rem) clamp(1.3rem, 2.8vw, 2.6rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: default;
    transition: opacity 0.4s, transform 0.6s var(--ease);
  }
  .game__overlay:global(.is-hidden) {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }
  .game__overlay p {
    font-weight: 500;
  }
  .game__btn {
    --btn-bg: #fff;
    --btn-fg: #111;
  }
  .game__btn::before {
    background: #111;
  }
  .game__btn:hover {
    color: #fff;
  }

  /* ---------- Galerie ---------- */
  .gal {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .gal__title {
    margin-bottom: clamp(1.4rem, 3vw, 2.4rem);
    font-size: clamp(1.8rem, 3.4vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.022em;
  }

  @media (max-width: 900px) {
    /* Handy und Tablet hochkant: Titel oben, Berg in der Mitte, Schalter unten */
    .shero__text {
      inset: calc(var(--nav-h) + 0.6rem) var(--edge) var(--edge) var(--edge);
      max-width: none;
      grid-template-rows: auto auto 1fr;
      align-items: start;
    }
    .season {
      align-self: end;
      justify-self: center;
    }
    /* kleines Wort: es steht höher über dem Gipfel, damit Berg und Wolken es nicht verdecken */
    .shero__word {
      top: calc(var(--peak-y, 50%) - 0.66em);
      font-size: min(25vw, 24svh);
    }
    .shero__hint {
      display: none;
    }
    .why__grid,
    .tt__info {
      grid-template-columns: 1fr;
    }
    .facts__row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .facts__row li + li {
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      padding-top: 2rem;
    }
  }
  @media (max-width: 760px) {
    .blocks__grid {
      grid-template-columns: 1fr;
    }
    .block {
      min-height: 21rem;
    }
    .block--wide {
      min-height: 26rem;
    }
    .game__overlay p {
      flex-basis: 100%;
    }
  }
</style>
